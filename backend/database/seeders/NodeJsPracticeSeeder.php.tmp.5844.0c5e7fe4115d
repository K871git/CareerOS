<?php

namespace Database\Seeders;

use App\Models\LearningTrack;
use App\Models\Subject;
use App\Models\Topic;
use App\Models\Question;
use App\Models\QuestionOption;
use Illuminate\Database\Seeder;

class NodeJsPracticeSeeder extends Seeder
{
    public function run(): void
    {
        $track = LearningTrack::firstOrCreate(
            ['slug' => 'backend-engineering'],
            [
                'title'         => 'Backend Engineering',
                'description'   => 'Backend engineering — server-side development, APIs, databases, and infrastructure.',
                'display_order' => 3,
            ]
        );

        $subject = Subject::firstOrCreate(
            ['slug' => 'nodejs'],
            [
                'learning_track_id' => $track->id,
                'title'             => 'Node.js',
                'description'       => 'Node.js is a JavaScript runtime built on Chrome\'s V8 engine. Master the event loop, async programming, streams, modules, and building production-grade server applications.',
                'display_order'     => 6,
            ]
        );

        $levels = [
            [
                'title'         => 'Node.js Basics — Junior',
                'slug'          => 'nodejs-junior',
                'description'   => 'Event loop, modules, file system, and core concepts. Perfect for junior-level interview preparation.',
                'display_order' => 1,
                'difficulty'    => 'Easy',
                'questions'     => $this->juniorQuestions(),
            ],
            [
                'title'         => 'Node.js Intermediate',
                'slug'          => 'nodejs-intermediate',
                'description'   => 'Streams, buffers, clusters, error handling, and building APIs. For developers targeting mid-level roles.',
                'display_order' => 2,
                'difficulty'    => 'Medium',
                'questions'     => $this->intermediateQuestions(),
            ],
            [
                'title'         => 'Node.js Advanced',
                'slug'          => 'nodejs-advanced',
                'description'   => 'Worker threads, performance, memory management, and production patterns. Essential for senior developer interviews.',
                'display_order' => 3,
                'difficulty'    => 'Hard',
                'questions'     => $this->advancedQuestions(),
            ],
        ];

        foreach ($levels as $levelData) {
            $topic = Topic::firstOrCreate(
                ['slug' => $levelData['slug']],
                [
                    'subject_id'    => $subject->id,
                    'title'         => $levelData['title'],
                    'description'   => $levelData['description'],
                    'display_order' => $levelData['display_order'],
                ]
            );

            foreach ($levelData['questions'] as $qData) {
                $exists = Question::where('topic_id', $topic->id)
                    ->where('question', $qData['question'])
                    ->exists();
                if ($exists) {
                    continue;
                }

                $question = Question::create([
                    'topic_id'    => $topic->id,
                    'type'        => 'MCQ',
                    'difficulty'  => $levelData['difficulty'],
                    'question'    => $qData['question'],
                    'explanation' => $qData['explanation'],
                ]);

                foreach ($qData['options'] as $opt) {
                    QuestionOption::create([
                        'question_id' => $question->id,
                        'option_text' => $opt['text'],
                        'is_correct'  => $opt['correct'],
                    ]);
                }
            }
        }

        $this->command->info('Node.js Practice seeded: 1 subject, 3 topics, 30 questions.');
    }

    private function juniorQuestions(): array
    {
        return [
            [
                'question'    => 'What is Node.js?',
                'explanation' => 'Node.js is a JavaScript runtime environment built on Google Chrome\'s V8 JavaScript engine. It allows JavaScript to run on the server side (outside the browser), enabling developers to build scalable network applications. Unlike traditional server-side languages, Node.js uses a non-blocking, event-driven I/O model, making it efficient for data-intensive real-time applications.',
                'options'     => [
                    ['text' => 'A JavaScript runtime built on Chrome\'s V8 engine for running JS on the server', 'correct' => true],
                    ['text' => 'A JavaScript framework for building frontend single-page applications', 'correct' => false],
                    ['text' => 'A database management system for JavaScript developers', 'correct' => false],
                    ['text' => 'A package manager for JavaScript projects', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is the Node.js event loop?',
                'explanation' => 'The event loop is the core mechanism that allows Node.js to perform non-blocking I/O operations despite being single-threaded. It continuously checks the call stack and the callback queue. When the call stack is empty, it picks up callbacks from the queue (timers, I/O callbacks, etc.) and executes them. This design allows Node.js to handle thousands of concurrent connections efficiently.',
                'options'     => [
                    ['text' => 'The mechanism that processes async callbacks when the call stack is empty', 'correct' => true],
                    ['text' => 'A loop that runs your application code multiple times per second', 'correct' => false],
                    ['text' => 'A for loop used internally by Node.js for iteration', 'correct' => false],
                    ['text' => 'A listener that watches for new HTTP requests', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is npm?',
                'explanation' => 'npm (Node Package Manager) is the default package manager for Node.js. It has two main functions: (1) a command-line tool for installing, updating, and managing packages/dependencies, and (2) an online registry (npmjs.com) hosting hundreds of thousands of open-source JavaScript packages. `npm install` installs dependencies listed in `package.json`.',
                'options'     => [
                    ['text' => 'The default package manager for Node.js used to install and manage dependencies', 'correct' => true],
                    ['text' => 'Node Process Manager — a tool for managing running Node.js processes', 'correct' => false],
                    ['text' => 'Node\'s built-in module for making HTTP requests', 'correct' => false],
                    ['text' => 'A testing framework for Node.js applications', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is the difference between `require()` and `import` in Node.js?',
                'explanation' => '`require()` is CommonJS (CJS) syntax — synchronous, available in all Node.js versions without configuration, loads modules dynamically. `import` is ES Modules (ESM) syntax — asynchronous, requires either `.mjs` extension or `"type": "module"` in package.json, supports static analysis and tree-shaking. Both can coexist but cannot be mixed freely without configuration.',
                'options'     => [
                    ['text' => 'require() is CommonJS (synchronous); import is ES Modules (static, needs "type":"module")', 'correct' => true],
                    ['text' => 'require() is for local files; import is for npm packages', 'correct' => false],
                    ['text' => 'They are identical — just different syntax for the same operation', 'correct' => false],
                    ['text' => 'import is faster because it is asynchronous; require() blocks the thread', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is `package.json` in a Node.js project?',
                'explanation' => '`package.json` is the manifest file for a Node.js project. It contains metadata: project name, version, description, author, license. Critically, it lists `dependencies` (runtime packages) and `devDependencies` (build/test tools). It also defines `scripts` for common commands (e.g., `"start": "node index.js"`, `"test": "jest"`). Running `npm install` reads this file to install all listed dependencies.',
                'options'     => [
                    ['text' => 'The project manifest file defining dependencies, scripts, and project metadata', 'correct' => true],
                    ['text' => 'A JSON file that stores the application\'s runtime configuration settings', 'correct' => false],
                    ['text' => 'A lock file that records the exact versions of installed packages', 'correct' => false],
                    ['text' => 'A file that defines API endpoints for the Node.js server', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What does "non-blocking I/O" mean in Node.js?',
                'explanation' => 'Non-blocking I/O means that when Node.js performs an I/O operation (reading a file, database query, HTTP request), it does not pause execution to wait for the result. Instead, it registers a callback and continues executing other code. When the I/O operation completes, the callback is placed in the event queue and executed when the call stack is free. This allows handling many concurrent operations with a single thread.',
                'options'     => [
                    ['text' => 'I/O operations run in the background; Node continues executing without waiting for results', 'correct' => true],
                    ['text' => 'Node.js blocks the thread during I/O but uses multiple threads to compensate', 'correct' => false],
                    ['text' => 'All I/O operations in Node.js are performed synchronously for data integrity', 'correct' => false],
                    ['text' => 'Node.js prevents multiple I/O operations from running simultaneously', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is the `fs` module in Node.js?',
                'explanation' => 'The `fs` (File System) module is a built-in Node.js module that provides an API for interacting with the file system. It offers both synchronous (`fs.readFileSync()`) and asynchronous (`fs.readFile()`) methods for reading, writing, updating, and deleting files and directories. The async versions are preferred in production to avoid blocking the event loop. Available via `require(\'fs\')`.',
                'options'     => [
                    ['text' => 'The built-in File System module for reading, writing, and managing files', 'correct' => true],
                    ['text' => 'The Full Stack module for managing frontend and backend code', 'correct' => false],
                    ['text' => 'A third-party module for managing static file serving in Express', 'correct' => false],
                    ['text' => 'The Function Scope module for managing variable scoping', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is a callback function in Node.js?',
                'explanation' => 'A callback is a function passed as an argument to another function, to be called when an async operation completes. Node.js uses the error-first callback convention: the first argument is an error (or null if no error), and subsequent arguments are the results. Example: `fs.readFile("file.txt", (err, data) => { if (err) throw err; console.log(data); })`. Callbacks were the original async pattern before Promises.',
                'options'     => [
                    ['text' => 'A function passed as an argument, called when an async operation completes', 'correct' => true],
                    ['text' => 'A special function that runs automatically when Node.js starts', 'correct' => false],
                    ['text' => 'A function that calls back to the browser from the server', 'correct' => false],
                    ['text' => 'The return value of an asynchronous function call', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is the `http` module in Node.js used for?',
                'explanation' => 'The `http` module is a built-in Node.js module for creating HTTP servers and making HTTP requests. `http.createServer((req, res) => { res.end("Hello"); }).listen(3000)` creates a basic server. While it is the foundation of all Node.js web frameworks, most real applications use Express or other frameworks built on top of `http` for routing, middleware, and convenience.',
                'options'     => [
                    ['text' => 'Creating HTTP servers and making HTTP requests — the foundation for web servers', 'correct' => true],
                    ['text' => 'Managing HTTP session cookies and authentication tokens', 'correct' => false],
                    ['text' => 'A module for making HTTPS requests with SSL certificate validation', 'correct' => false],
                    ['text' => 'Configuring HTTP headers for static file responses', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is the difference between `process.nextTick()` and `setTimeout(() => {}, 0)` in Node.js?',
                'explanation' => '`process.nextTick()` executes the callback at the end of the current operation, before the event loop continues — it is not part of the event loop phases but runs between each phase. `setTimeout(() => {}, 0)` schedules execution in the "timers" phase of the next event loop iteration, after I/O events are processed. `nextTick` fires first and is used for deferring work until after the current operation but before yielding to I/O.',
                'options'     => [
                    ['text' => 'nextTick fires before the next event loop tick; setTimeout(0) fires in the timers phase', 'correct' => true],
                    ['text' => 'They are identical — both execute the callback immediately', 'correct' => false],
                    ['text' => 'setTimeout(0) fires first; nextTick is deferred until all timers complete', 'correct' => false],
                    ['text' => 'nextTick is synchronous; setTimeout(0) runs asynchronously', 'correct' => false],
                ],
            ],
        ];
    }

    private function intermediateQuestions(): array
    {
        return [
            [
                'question'    => 'What is the difference between Promises and async/await in Node.js?',
                'explanation' => 'Promises represent the eventual result of an async operation — `.then()` chains handle success, `.catch()` handles errors. Async/await is syntactic sugar over Promises: `async` marks a function as returning a Promise, and `await` pauses execution within that function until the Promise resolves. Async/await produces flatter, more readable code. Under the hood, both compile to the same Promise-based mechanism.',
                'options'     => [
                    ['text' => 'async/await is syntactic sugar over Promises — both resolve the same way, just different syntax', 'correct' => true],
                    ['text' => 'Promises are newer and faster; async/await is legacy Node.js syntax', 'correct' => false],
                    ['text' => 'async/await uses threads; Promises use the single-threaded event loop', 'correct' => false],
                    ['text' => 'They are completely different mechanisms — Promises are non-blocking, await blocks the thread', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is a Node.js stream and when should you use one?',
                'explanation' => 'Streams are objects that let you read or write data in chunks rather than loading the entire data into memory. Types: Readable (e.g., `fs.createReadStream`), Writable (e.g., `fs.createWriteStream`), Duplex (both), Transform (modify data as it passes). Streams are ideal for processing large files, HTTP responses, or piping data between sources. `readable.pipe(writable)` is the classic pattern.',
                'options'     => [
                    ['text' => 'Objects that process data in chunks — ideal for large files to avoid loading all into memory', 'correct' => true],
                    ['text' => 'Streams are async generators used to loop over database query results', 'correct' => false],
                    ['text' => 'A WebSocket connection pattern for real-time data between client and server', 'correct' => false],
                    ['text' => 'A way to stream console.log output to log files in production', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is the Node.js cluster module?',
                'explanation' => 'The cluster module allows creating child processes (workers) that share the same server port. Since Node.js is single-threaded, clustering lets you take advantage of multi-core CPUs — typically creating one worker per CPU core. The master process manages workers; workers handle actual requests. PM2 and other process managers abstract this pattern. `cluster.fork()` creates a new worker.',
                'options'     => [
                    ['text' => 'A module for spawning child processes that share a server port, utilizing multiple CPU cores', 'correct' => true],
                    ['text' => 'A way to cluster database connections in a connection pool', 'correct' => false],
                    ['text' => 'A module for grouping related Node.js modules into clusters', 'correct' => false],
                    ['text' => 'Docker clustering support built into Node.js for container orchestration', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is middleware in the context of Node.js?',
                'explanation' => 'In Node.js (especially Express), middleware are functions that have access to the request object (`req`), response object (`res`), and the `next` function. They execute sequentially in the order they are defined. Middleware can: execute code, modify req/res, end the request-response cycle, or call `next()` to pass to the next middleware. Uses include logging, authentication, body parsing, and error handling.',
                'options'     => [
                    ['text' => 'Functions in the request-response pipeline that can inspect/modify req, res, or call next()', 'correct' => true],
                    ['text' => 'Middleware is a separate server that sits between the client and Node.js application', 'correct' => false],
                    ['text' => 'Third-party npm packages that wrap core Node.js APIs for convenience', 'correct' => false],
                    ['text' => 'Shared memory between multiple Node.js processes for data passing', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is the EventEmitter class in Node.js?',
                'explanation' => 'EventEmitter is Node.js\'s built-in implementation of the observer/publish-subscribe pattern. Objects that extend EventEmitter can emit named events and register listeners for those events. `emitter.on("event", callback)` registers a listener; `emitter.emit("event", data)` fires it. Many core Node.js APIs (streams, HTTP server, etc.) extend EventEmitter. It enables event-driven architecture.',
                'options'     => [
                    ['text' => 'Node\'s built-in pub/sub class — emit named events with .emit() and listen with .on()', 'correct' => true],
                    ['text' => 'A class that emits browser DOM events from the server', 'correct' => false],
                    ['text' => 'A WebSocket wrapper for emitting real-time events to clients', 'correct' => false],
                    ['text' => 'A class for managing timer events (setTimeout, setInterval)', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is the difference between `dependencies` and `devDependencies` in package.json?',
                'explanation' => '`dependencies` are packages required for the application to run in production (Express, database drivers, utility libraries). `devDependencies` are packages only needed during development or the build process (testing frameworks like Jest, TypeScript, ESLint, Webpack). Running `npm install --production` or `NODE_ENV=production npm install` skips devDependencies — keeping production installs lean.',
                'options'     => [
                    ['text' => 'dependencies are for production runtime; devDependencies are for development/build only', 'correct' => true],
                    ['text' => 'dependencies are installed globally; devDependencies are project-local', 'correct' => false],
                    ['text' => 'devDependencies are faster to install; dependencies include all transitive packages', 'correct' => false],
                    ['text' => 'There is no practical difference — both are installed by npm install', 'correct' => false],
                ],
            ],
            [
                'question'    => 'How does error handling work in async Node.js code?',
                'explanation' => 'For callbacks: use the error-first pattern (`if (err) return next(err)`). For Promises: use `.catch()` at the end of the chain. For async/await: wrap in `try/catch` blocks. Unhandled promise rejections can be caught globally with `process.on("unhandledRejection", ...)`. Express provides an error-handling middleware with 4 parameters `(err, req, res, next)` as the central error handler.',
                'options'     => [
                    ['text' => 'try/catch for async/await, .catch() for Promises, error-first callbacks for legacy code', 'correct' => true],
                    ['text' => 'Node.js automatically catches all async errors — no explicit handling needed', 'correct' => false],
                    ['text' => 'Only synchronous errors can be caught; async errors must be logged and ignored', 'correct' => false],
                    ['text' => 'Use process.exit() to handle all uncaught errors and restart the server', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is `Buffer` in Node.js?',
                'explanation' => 'A Buffer is a fixed-size chunk of memory (outside of the V8 heap) used to work with binary data directly. Since JavaScript strings are UTF-16 encoded, Buffers are necessary when working with raw binary streams — TCP packets, file data, cryptography. Created with `Buffer.from()`, `Buffer.alloc()`, or `Buffer.allocUnsafe()`. Buffers can be converted to strings with `buf.toString("utf8")`.',
                'options'     => [
                    ['text' => 'A fixed-size allocation of raw binary memory for working with binary data outside V8 heap', 'correct' => true],
                    ['text' => 'A queue that buffers HTTP requests when the server is under high load', 'correct' => false],
                    ['text' => 'A caching layer for frequently accessed database query results', 'correct' => false],
                    ['text' => 'A browser API polyfill that Node.js provides for client-side compatibility', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is the purpose of `__dirname` and `__filename` in Node.js?',
                'explanation' => '`__dirname` is a global variable that provides the absolute path of the directory containing the currently executing module file. `__filename` provides the absolute path of the module file itself. These are essential for constructing reliable file paths that work regardless of where the process was launched from. Note: these are not available in ES Modules (use `import.meta.url` instead).',
                'options'     => [
                    ['text' => '__dirname is the absolute path of the current directory; __filename is the current file path', 'correct' => true],
                    ['text' => '__dirname is the project root; __filename is a relative path from the root', 'correct' => false],
                    ['text' => '__filename is the entry point file; __dirname is the main module directory', 'correct' => false],
                    ['text' => 'They are environment variables set by the OS for the running process', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is the `path` module in Node.js used for?',
                'explanation' => 'The `path` module provides utilities for working with file and directory paths in a cross-platform way. Key methods: `path.join()` (concatenates path segments with the correct separator), `path.resolve()` (resolves to an absolute path), `path.basename()` (returns the filename), `path.dirname()` (returns the directory), `path.extname()` (returns the extension). Critical for cross-platform compatibility (Windows uses `\\`, Unix uses `/`).',
                'options'     => [
                    ['text' => 'A built-in module for cross-platform file path manipulation (join, resolve, basename)', 'correct' => true],
                    ['text' => 'A module for managing URL paths in Express routing', 'correct' => false],
                    ['text' => 'A module that provides the system PATH environment variable management', 'correct' => false],
                    ['text' => 'A routing module for defining HTTP request paths', 'correct' => false],
                ],
            ],
        ];
    }

    private function advancedQuestions(): array
    {
        return [
            [
                'question'    => 'What are Worker Threads in Node.js and when should you use them?',
                'explanation' => 'Worker Threads (available since Node.js 10.5) run JavaScript in parallel threads, each with their own V8 instance and event loop. Unlike clustering (separate processes), Worker Threads share memory via SharedArrayBuffer. Use Worker Threads for CPU-intensive tasks (image processing, cryptography, data parsing) that would block the event loop. For I/O-bound tasks, async I/O is sufficient — Worker Threads are overkill.',
                'options'     => [
                    ['text' => 'Threads for CPU-intensive work that shares memory — avoids blocking the event loop', 'correct' => true],
                    ['text' => 'A way to run multiple servers on worker machines in a distributed system', 'correct' => false],
                    ['text' => 'Browser Web Workers ported to Node.js for background DOM manipulation', 'correct' => false],
                    ['text' => 'Child processes spawned by the cluster module for parallel request handling', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is the libuv library and its relationship to Node.js?',
                'explanation' => 'libuv is a multi-platform C library that provides Node.js with its event loop, thread pool, and asynchronous I/O support. When Node.js encounters blocking operations (file I/O, DNS, crypto), libuv offloads them to a thread pool (default: 4 threads, configurable with `UV_THREADPOOL_SIZE`). The event loop itself runs on the main thread. libuv is what makes "single-threaded" Node.js actually perform async I/O.',
                'options'     => [
                    ['text' => 'The C library that provides Node.js\'s event loop, thread pool, and async I/O primitives', 'correct' => true],
                    ['text' => 'The JavaScript engine that compiles and runs Node.js code', 'correct' => false],
                    ['text' => 'A Node.js native addon for UV (ultraviolet) data processing', 'correct' => false],
                    ['text' => 'A Linux utility library that Node.js uses exclusively on Unix systems', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is a memory leak in Node.js and how do you detect one?',
                'explanation' => 'A memory leak occurs when memory is allocated but never released — the heap grows indefinitely, eventually causing OOM crashes. Common causes in Node.js: global variables accumulating data, event listeners not removed (`emitter.removeListener()`), closures holding references, caching without limits. Detection tools: `process.memoryUsage()`, Chrome DevTools heap snapshots with `--inspect`, clinic.js, and heap profiling with `v8.writeHeapSnapshot()`.',
                'options'     => [
                    ['text' => 'Memory allocated but never released — detected via heap snapshots and process.memoryUsage()', 'correct' => true],
                    ['text' => 'A memory leak is when two variables reference each other, crashing Node.js immediately', 'correct' => false],
                    ['text' => 'When Node.js runs out of disk space for log files — check with df -h', 'correct' => false],
                    ['text' => 'Memory leaks are impossible in Node.js because V8 has automatic garbage collection', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What are the phases of the Node.js event loop in order?',
                'explanation' => 'The event loop has 6 phases (in order): 1) Timers (executes setTimeout/setInterval callbacks that have expired), 2) Pending I/O callbacks (I/O errors from previous cycle), 3) Idle/Prepare (internal use), 4) Poll (retrieve new I/O events — blocks here if queue is empty), 5) Check (setImmediate() callbacks), 6) Close callbacks (socket.on("close")). Between each phase, Node.js runs microtasks: `process.nextTick()` first, then Promises.',
                'options'     => [
                    ['text' => 'Timers → Pending I/O → Idle → Poll → Check (setImmediate) → Close callbacks', 'correct' => true],
                    ['text' => 'Poll → Timers → I/O → setImmediate → nextTick → Promises', 'correct' => false],
                    ['text' => 'Macrotasks → Microtasks → Timers → I/O → Render', 'correct' => false],
                    ['text' => 'Promises → nextTick → setTimeout → setImmediate → I/O', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is the difference between `child_process.fork()`, `spawn()`, and `exec()` in Node.js?',
                'explanation' => '`exec()` runs a shell command, buffers output in memory, fires a callback — good for short commands with small output. `spawn()` streams stdout/stderr — better for large output or long-running processes. `fork()` is a specialized spawn for Node.js scripts — creates a new V8 instance with its own event loop and establishes an IPC channel for message passing with the parent. `fork()` is more expensive but enables communication.',
                'options'     => [
                    ['text' => 'exec() buffers output; spawn() streams it; fork() is spawn for Node.js with IPC channel', 'correct' => true],
                    ['text' => 'They are aliases for the same operation — all spawn a child process identically', 'correct' => false],
                    ['text' => 'fork() is for threads; spawn() is for processes; exec() is for shell scripts only', 'correct' => false],
                    ['text' => 'exec() is async; spawn() and fork() are synchronous child process creators', 'correct' => false],
                ],
            ],
            [
                'question'    => 'What is backpressure in Node.js streams?',
                'explanation' => 'Backpressure occurs when a Writable stream cannot process data as fast as a Readable stream produces it — the buffer fills up. The Writable\'s `write()` method returns `false` when the buffer is full. The Readable should pause production until the Writable emits a `drain` event. Using `pipe()` handles backpressure automatically. Ignoring backpressure leads to unbounded memory growth and potential OOM crashes.',
                'options'     => [
                    ['text' => 'When a writable stream\'s buffer is full — readable must pause until drain event fires', 'correct' => true],
                    ['text' => 'CPU pressure from too many concurrent requests causing the event loop to back up', 'correct' => false],
                    ['text' => 'A network congestion signal sent from servers to clients via HTTP/2', 'correct' => false],
                    ['text' => 'The process of compressing stream data to reduce memory usage', 'correct' => false],
                ],
            ],
            [
                'question'    => 'How does Node.js handle uncaught exceptions?',
                'explanation' => 'Uncaught exceptions in Node.js terminate the process by default. You can intercept them with `process.on("uncaughtException", (err) => { ... })`, but the application is in an undefined state after this — the recommended practice is to log the error and gracefully shut down rather than continue. Similarly, `process.on("unhandledRejection", ...)` catches unhandled Promise rejections (which became fatal in Node.js 15+).',
                'options'     => [
                    ['text' => 'They terminate the process by default — intercept with uncaughtException but then shut down', 'correct' => true],
                    ['text' => 'Node.js automatically restarts itself when an uncaught exception occurs', 'correct' => false],
                    ['text' => 'Uncaught exceptions are silently swallowed and logged to stderr', 'correct' => false],
